<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <AssemblyName>selfsign</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <NoWarn>$(NoWarn);IDE0073</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Independent tool: keep outputs local, don't inherit the repo's artifacts/ redirect -->
    <BaseOutputPath>bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
    <RestoreOutputPath>obj/</RestoreOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="selfsign.cs" />
  </ItemGroup>
</Project>
