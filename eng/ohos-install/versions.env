# ============================================================================
# versions.env — single source for the OpenHarmony port's version pins.
#
# Sourced by eng/ohos-install/*.sh, eng/ohos-install/build/* and the
# .github/workflows/ohos-*.yml jobs. Every value is written as
# "${VAR:=default}" so an exported environment value (or a workflow input)
# still wins over the default.
#
# Keep the three product repos (runtime / aspnetcore / sdk) on one version
# line: release tags are "<version>-ohos" (frozen build line) and
# "<version>-openharmony" (distribution line, see ohos-release-mirror.yml).
# ============================================================================

# ---- GitHub account hosting the -ohos forks and their release assets -------
: "${GH_USER:=springmin}"

# ---- product versions ------------------------------------------------------
# Current line is the official rc.2 line: runtime/aspnetcore and the SDK redist
# are built with buildid 20261004.105, which lands on the official rc.2
# versions (11.0.0-rc.2.26504.105 / 11.0.100-rc.2.26504.105). The legacy rc.1
# line (11.0.0-rc.1.26451.109 / buildid 20260901.109) stays available through
# explicit overrides until it is retired: pass --buildid 20260901.109 (or
# -f buildid=20260901.109) together with the legacy version values.
: "${VERSION_BAND:=11.0.0}"                             # runtime / aspnetcore band
: "${SDK_BAND:=11.0.100}"                               # sdk band (band 100)
: "${RT_VERSION:=11.0.0-rc.2.26504.105}"                # runtime + aspnetcore
: "${SDK_VERSION:=11.0.100-rc.2.26504.105}"             # sdk redist
: "${DEFAULT_BUILDID:=20261004.105}"                    # OfficialBuildId fallback (current rc.2 line; legacy rc.1 passes 20260901.109 explicitly)
: "${BOOTSTRAP_SDK_VERSION:=11.0.100-rc.1.26420.103}"   # bootstrap SDK (runtime/aspnetcore)
: "${BOOTSTRAP_RUNTIME_VERSION:=11.0.0-rc.1.26420.103}" # runtime bundled in that SDK (shared/Microsoft.NETCore.App)

# ---- target -----------------------------------------------------------------
: "${RID:=openharmony-arm64}"

# ---- bootstrap SDK whose RID graph carries the openharmony entries ----------
: "${RIDGRAPH_SDK_VERSION:=11.0.100-preview.6.26359.118}"

# ---- stock (official) linux-x64 crossgen2 for framework R2R -----------------
# Local default (dnceng) and the version CI passes (matches the runtime branch
# R2R version). Digests are pinned per version; add a pin when the version
# changes (or export STOCK_CROSSGEN2_SHA256).
: "${STOCK_CROSSGEN2_VERSION:=11.0.0-rc.1.26427.131}"
: "${CI_STOCK_CROSSGEN2_VERSION:=11.0.0-rc.1.26451.109}"
stock_crossgen2_sha256() {
    case "$1" in
        11.0.0-rc.1.26427.131) printf '%s' "c8d42378a12889a45d1b68e89d1fd74cbc5075879e3630c0276fbdfd7197340e" ;;
        11.0.0-rc.1.26451.109) printf '%s' "5da0dafca92667d2f48c79d69059ef4924cefc87de7fa07cc6a1d8299ad798aa" ;;
        *) printf '%s' "" ;;
    esac
}

# ---- reference runtime pack (ohos-arm64 R2R-PGO): metadata + PGO mibc -------
: "${REFERENCE_RUNTIME_PACK_VERSION:=11.0.0-rc.1.26451.109}"
: "${REFERENCE_RUNTIME_PACK_ASSET:=Microsoft.NETCore.App.Runtime.ohos-arm64.${REFERENCE_RUNTIME_PACK_VERSION}-R2R-PGO.nupkg}"
: "${REFERENCE_RUNTIME_PACK_SHA256:=54d093f5bf3d522917cbe51a42ab2450ecd77b78be83214fe52ca6e5aac92163}"

# ---- musl alias bootstrap source -------------------------------------------
# Fallback base for the linux-musl runtime-pack alias when the first build of a
# new line runs before v<RT_VERSION>-ohos exists. Set to the newest published
# runtime version; the alias rewrite versions it per target, so any published
# OpenHarmony runtime pack is a valid base. Empty disables the fallback.
: "${ALIAS_SOURCE_RUNTIME_VERSION:=11.0.0-rc.2.26451.112}"

# ---- device-side selfsign asset (sdk release, same tag as the SDK) ----------
: "${SELFSIGN_ASSET:=selfsign-ohos-arm64}"

# ---- OpenHarmony platform workload bundle (sdk-ohos release assets) ---------
# The bundle is repackaged with every workload/SDK release: the versioned asset
# openharmony-workload-<version>.tar.gz and the rolling
# openharmony-workload-latest.tar.gz are byte-identical at release time.
# WORKLOAD_BUNDLE_VERSION selects the versioned asset name and is refreshed
# together with WORKLOAD_BUNDLE_SHA256 on every bundle repackage.
: "${WORKLOAD_BUNDLE_VERSION:=1.0.0-preview.29}"

# ---- NativeAOT packs (offline feed / release mirror) -------------------------
# NativeAOT publish (dotnet publish -r openharmony-arm64 -p:PublishAot=true)
# needs a host ILCompiler pack and a target NativeAOT runtime pack. The releases
# below mirror them for offline use; fetch-nativeaot-packs.sh verifies the
# digests pinned here before adding them to a local feed.
#   openharmony-arm64: built from the fork (runtime-ohos feature/openharmony
#                      @d4a4e25c89f) - required for device-side ilc.
#   linux-musl-arm64 / win-x64: official nuget.org packages (26425.128 line).
# linux-musl-* artifacts re-tagged to the 26451.109 band are byte-identical
# re-packs (nuspec version string only) so a 26451.109 SDK can restore them.
#
# One mirror release per build line; AOT_PACKS_VERSION selects the line and
# defaults to RT_VERSION, so a product-line bump resolves the matching mirror
# automatically. An unmapped line fails closed and lists the known lines
# (kit #57 NU1100 regression: the .105 packs were only on runtime-ohos until
# 2026-10-15, and the fetch script then still asked for the .112 assets).
# AOT_PACKS_TAG overrides the tag for custom mirrors; a tag that names a known
# line also selects that line's assets/pins (the rc.1 fallback keeps working).
#   11.0.0-rc.2.26504.105  aot-packs-11.0.0-rc.2.26504.105  (.105 re-cut)
#   11.0.0-rc.2.26451.112  aot-packs-11.0.0-rc.2              (historical)
#   11.0.0-rc.1.26451.109  aot-packs-11.0.0-rc.1              (rc.1 line)
# The openharmony-arm64 rc.2 .112 runtime pack is fetched as `...-struct1`: a
# re-cut of the rc.2 mirror built from the structurally fixed source
# (runtime-ohos feature/openharmony; FEATURE_DISTRO_AGNOSTIC_SSL_STATIC keeps
# the dlopen shim in the AOT static archive while the shared .so links OpenSSL
# statically). See runtime-ohos docs/plans/2026-10-03-ohos-aotpack-structural.md
# and docs/plans/2026-10-03-ohos-aotpack-rebuild.md.
# History: the 2026-09-27 full build dropped the shim from the pack's static
# libSystem.Security.Cryptography.Native.OpenSsl.a (NativeAOT links it into the
# app without libcrypto/libssl, so crypto use failed with undefined
# EVP_*/X509_*). The old `-r2` asset was a manual re-pack of that archive and is
# no longer needed; the original 46d221f2... pack and -r2 stay in the release
# for history but are NOT pinned - only -struct1 carries the shim. The .105
# pack is a fresh build of the structurally fixed source (no re-suffix).
: "${AOT_PACKS_VERSION:=$RT_VERSION}"
AOT_PACKS_REPO="${AOT_PACKS_REPO:-${GH_USER}/sdk-ohos}"
aot_packs_tag() { # <version> -> mirror release tag ("" = line not mirrored)
    case "$1" in
        11.0.0-rc.2.26504.105) printf '%s' "aot-packs-11.0.0-rc.2.26504.105" ;;
        11.0.0-rc.2.26451.112) printf '%s' "aot-packs-11.0.0-rc.2" ;;
        11.0.0-rc.1.26451.109) printf '%s' "aot-packs-11.0.0-rc.1" ;;
        *) printf '%s' "" ;;
    esac
}
aot_packs_tag_version() { # <tag> -> line version ("" = not a known mirror tag)
    case "$1" in
        aot-packs-11.0.0-rc.2.26504.105) printf '%s' "11.0.0-rc.2.26504.105" ;;
        aot-packs-11.0.0-rc.2)           printf '%s' "11.0.0-rc.2.26451.112" ;;
        aot-packs-11.0.0-rc.1)           printf '%s' "11.0.0-rc.1.26451.109" ;;
        *) printf '%s' "" ;;
    esac
}
aot_packs_known_lines() { # the lines with a mirrored AOT set
    printf '%s\n' 11.0.0-rc.2.26504.105 11.0.0-rc.2.26451.112 11.0.0-rc.1.26451.109
}
aot_packs_assets() { # <version> -> mirrored openharmony nupkgs (one per line)
    case "$1" in
        11.0.0-rc.2.26504.105)
            printf '%s\n' \
                "Microsoft.NETCore.App.Runtime.NativeAOT.openharmony-arm64.$1.nupkg" \
                "runtime.openharmony-arm64.Microsoft.DotNet.ILCompiler.$1.nupkg" ;;
        11.0.0-rc.2.26451.112)
            printf '%s\n' \
                "Microsoft.NETCore.App.Runtime.NativeAOT.openharmony-arm64.$1-struct1.nupkg" \
                "runtime.openharmony-arm64.Microsoft.DotNet.ILCompiler.$1.nupkg" ;;
        11.0.0-rc.1.26451.109)
            printf '%s\n' \
                "Microsoft.NETCore.App.Runtime.NativeAOT.openharmony-arm64.$1.nupkg" \
                "runtime.openharmony-arm64.Microsoft.DotNet.ILCompiler.$1.nupkg" ;;
        *) ;;
    esac
}
aot_pack_sha256() {
    case "$1" in
        "Microsoft.NETCore.App.Runtime.NativeAOT.openharmony-arm64.11.0.0-rc.1.26451.109.nupkg") printf '%s' "5baad9e83604528ffd207d60fe4a828a1f78da82a1695b5345e0d7ee3681d5e4" ;;
        "Microsoft.NETCore.App.Runtime.NativeAOT.openharmony-arm64.11.0.0-rc.2.26504.105.nupkg") printf '%s' "cfd2eab682d8200a2c6745a42eb6d0ed8ba2d84b189ae9a6652c57b24038ac46" ;;
        "runtime.openharmony-arm64.Microsoft.DotNet.ILCompiler.11.0.0-rc.2.26504.105.nupkg")   printf '%s' "04c239af6c594c3cca93e1cf3f1a4fd94c7b69d6a5ff351c75ab27771a4af425" ;;
        # rc.1 of this pack (5baad9e8...) keeps the dlopen shim; the rc.2 line is
        # the -struct1 re-cut from the structurally fixed source (see the note
        # above). The original 46d221f2... pack and the old -r2 re-pack are NOT
        # pinned: -r2 has the shim but predates the structural fix, and the
        # original has no shim at all.
        "Microsoft.NETCore.App.Runtime.NativeAOT.openharmony-arm64.11.0.0-rc.2.26451.112-struct1.nupkg") printf '%s' "09345f9515612f2b090fd0e0f54c815156105127cc1686240a3cad8521dab11c" ;;
        "runtime.openharmony-arm64.Microsoft.DotNet.ILCompiler.11.0.0-rc.1.26451.109.nupkg")   printf '%s' "999e73a7b41fdd5af42a613182a2577e9a276026b1a2f65295e29115b1b539e8" ;;
        "runtime.openharmony-arm64.Microsoft.DotNet.ILCompiler.11.0.0-rc.2.26451.112.nupkg")   printf '%s' "1c518a461cdb6d76640561b97170c2dc7d0e75fb55b475d00944a2e3cd7e67cd" ;;
        "microsoft.netcore.app.runtime.nativeaot.linux-musl-arm64.11.0.0-rc.1.26425.128.nupkg") printf '%s' "477b0c0ba48aae50beb973c5c205b98669eba6a4ba997abfae6f6f320c58bbf9" ;;
        "runtime.linux-musl-arm64.microsoft.dotnet.ilcompiler.11.0.0-rc.1.26425.128.nupkg")    printf '%s' "74637dbb6a492bddd963e0a184c1f2faa07ac540154a90ef0618798990e29c63" ;;
        "runtime.win-x64.microsoft.dotnet.ilcompiler.11.0.0-rc.1.26425.128.nupkg")             printf '%s' "abd9009e44faa2f44633790625ed448b3a1ac4bf0c102fce7fe6d16410275421" ;;
        "microsoft.netcore.app.runtime.nativeaot.linux-musl-arm64.11.0.0-rc.1.26451.109.nupkg") printf '%s' "8cdcb38808dd01a6a4b09c861f519d9619a73577ef38b2a3b487a54e7db4fd59" ;;
        "runtime.linux-musl-arm64.microsoft.dotnet.ilcompiler.11.0.0-rc.1.26451.109.nupkg")    printf '%s' "0b0bbd18dea3ddfb1fbc41bfb683be55be2fa4b04e08553044ed583f2de51ce7" ;;
        *) printf '%s' "" ;;
    esac
}
# Resolve the default tag once every resolver is defined. An explicitly set
# AOT_PACKS_TAG keeps its value (legacy hook); when it names a known mirror line
# the fetch script uses that line's assets and pins.
if [ -z "${AOT_PACKS_TAG:-}" ]; then
    AOT_PACKS_TAG="$(aot_packs_tag "$AOT_PACKS_VERSION")"
fi

# ---- Crossgen2 pack (JIT ReadyToRun for app publishes) ------------------------
# `dotnet publish -r openharmony-arm64 -p:PublishReadyToRun=true` needs the
# openharmony-arm64 Crossgen2 pack on a folder feed, otherwise restore fails
# with NU1100. It is only for the JIT route (interp does not consume R2R code).
# One mirror release per line, same shape as the AOT mirrors above:
#   11.0.0-rc.2.26504.105  crossgen2-packs-11.0.0-rc.2.26504.105
#   11.0.0-rc.2.26451.112  crossgen2-packs-11.0.0-rc.2
crossgen2_packs_tag() { # <version> -> mirror release tag ("" = not mirrored)
    case "$1" in
        11.0.0-rc.2.26504.105) printf '%s' "crossgen2-packs-11.0.0-rc.2.26504.105" ;;
        11.0.0-rc.2.26451.112) printf '%s' "crossgen2-packs-11.0.0-rc.2" ;;
        *) printf '%s' "" ;;
    esac
}
crossgen2_pack_asset() { # <version> -> mirrored nupkg name ("" = not mirrored)
    case "$1" in
        11.0.0-rc.2.26504.105|11.0.0-rc.2.26451.112)
            printf 'Microsoft.NETCore.App.Crossgen2.openharmony-arm64.%s.nupkg' "$1" ;;
        *) printf '%s' "" ;;
    esac
}
crossgen2_pack_sha256() {
    case "$1" in
        "Microsoft.NETCore.App.Crossgen2.openharmony-arm64.11.0.0-rc.2.26504.105.nupkg") printf '%s' "11f87f0cd9000415e388c240ab63bfb5cc9c860c6e77b1ec0ab233a381d9c59e" ;;
        "Microsoft.NETCore.App.Crossgen2.openharmony-arm64.11.0.0-rc.2.26451.112.nupkg") printf '%s' "6bb8a375418b411f1ad24982b16fc56baedcdba66a9d2a42451c04c2921b1ee5" ;;
        *) printf '%s' "" ;;
    esac
}

# ---- bootstrap Ref pack (dnceng public dotnet11 feed) ------------------------
# `seed_bootstrap_ref` seeds the bootstrap targeting pack before any local ref
# exists. The pack must match the sources' pinned
# MicrosoftNETCoreAppRefPackageVersion: the rc2 sources use rc2-only platform
# APIs (Hpke etc.) that the rc.1 pack shipped with the bootstrap SDK cannot
# compile. The version is parsed from the runtime checkout and fetched from the
# public dnceng feed when it is not in the bootstrap packs. Digests measured
# from that feed.
dnceng_ref_pack_sha256() {
    case "$1" in
        11.0.0-rc.2.26465.108) printf '%s' "c4736bc6ed72af7d5884f94aa04e4b9f8875fb0938e12571014295dec72e07a6" ;;
        *) printf '%s' "" ;;
    esac
}

# ---- release asset digest anchors -------------------------------------------
# sha256 of the release assets the installer downloads. These pins live in the
# trusted repository, so replacing the artifact and a same-release SHA256SUMS
# together (malicious mirror / release compromise) no longer defeats the
# check. Measured from the published releases of the pinned versions; update
# them together with the version pins above (and, for the workload bundle, with
# every bundle repackage). Empty means "no external anchor": the pinned GitHub
# release URLs then fall back to same-release evidence (with a warning), and
# user-supplied URLs are refused.
# Refreshed 2026-09-29 from the rc.2 release re-run (run 36518982917): the SDK
# tarball, the runtime tarball and the version-less selfsign asset are rebuilt
# by every release run (packaging/signing is not bit-reproducible), so these
# three anchors must be re-measured from the published release assets after
# every release that republishes them (see the plan's section 8).
: "${SDK_TARBALL_SHA256:=0f668e894e93d6a04cdf3ee85406eaa2d9431d47c432da804e68eac6ef7c0055}"
: "${RUNTIME_TARBALL_SHA256:=a228fa81a332cfae5c67c013a5b91a27efbff77c07c890514aa9d5c5f718f8b0}"
# The selfsign-ohos-arm64 asset is pulled from the release until the
# cross-built signer is fixed (it SIGSEGVs on device, rc=139); the installer
# warns and falls back to binary-sign-tool when the asset is missing. Left
# empty on purpose: a re-added asset must be anchored deliberately first.
: "${SELFSIGN_SHA256:=a403a1b4261b20a4c585fc294881d1ad7588f2aa3ffe81e3732d2031413cdfc2}"
: "${WORKLOAD_BUNDLE_SHA256:=21e2d128174513c0481e148aee391c8e4002c014587d8919a7cea311de0a706d}"

# anchored_asset_sha256 <asset-file-name> -> pinned hex digest or empty.
# Only assets whose exact name matches the pinned version/RID resolve, so a
# different RID or version falls back to the documented behaviour instead of
# failing against a wrong pin.
anchored_asset_sha256() {
    case "$1" in
        "dotnet-sdk-${SDK_VERSION}-${RID}.tar.gz")     printf '%s' "${SDK_TARBALL_SHA256:-}" ;;
        "dotnet-runtime-${RT_VERSION}-${RID}.tar.gz")  printf '%s' "${RUNTIME_TARBALL_SHA256:-}" ;;
        "${SELFSIGN_ASSET}")                           printf '%s' "${SELFSIGN_SHA256:-}" ;;
        "openharmony-workload-${WORKLOAD_BUNDLE_VERSION}.tar.gz") printf '%s' "${WORKLOAD_BUNDLE_SHA256:-}" ;;
        "openharmony-workload-latest.tar.gz")          printf '%s' "${WORKLOAD_BUNDLE_SHA256:-}" ;;
        *)                                             printf '%s' "" ;;
    esac
}

# ---- host linux-x64 runtime packs pre-seeded from the fork release ----------
# DNCENG_DOTNET11_VERSION: dnceng dotnet11 feed (same as the bootstrap runtime)
# BRANCH_VERSION:          the fork release 'host-runtime-packs' (and dotnet12 otherwise)
: "${HOST_PACK_DNCENG_DOTNET11_VERSION:=11.0.0-rc.1.26420.103}"
: "${HOST_PACK_BRANCH_VERSION:=11.0.0-rc.1.26431.109}"
: "${HOST_PACK_GITHUB_VERSIONS:=11.0.0-rc.1.26431.109 11.0.0-rc.1.26451.109}"
is_github_host_pack_version() {
    for v in $HOST_PACK_GITHUB_VERSIONS; do
        [ "$1" = "$v" ] && return 0
    done
    return 1
}
# ---- host runtime pack (linux-x64) anchored digests -------------------------
# The fork's host-runtime-packs release has no SHA256SUMS, so without a pin the
# expected digest for a github-sourced host pack comes from a GitHub API lookup
# that can fail transiently (run 36517651718 refused 11.0.0-rc.1.26431.109 that
# way). Pins win over the network-derived evidence. Digests measured from the
# API asset digests of the host-runtime-packs release.
host_pack_sha256() { # <id> <ver> -> hex or empty
    case "$1/$2" in
        microsoft.netcore.app.runtime.linux-x64/11.0.0-rc.1.26431.109) printf '%s' "446adf8b8221b12ccb53514401bbe7e059b0086791ca7139cdf21dc1207862bf" ;;
        microsoft.netcore.app.runtime.linux-x64/11.0.0-rc.1.26451.109) printf '%s' "e9d57abed90e959c99c3fad659b3b9b358beb4314f481e8d9f14b12596f029f9" ;;
        *) printf '%s' "" ;;
    esac
}

# ---- layout / local asset server --------------------------------------------
: "${TFM:=net11.0}"          # lib/<TFM> inside the runtime packs
: "${ASSET_PORT:=8000}"      # PublicBaseURL=http://localhost:<port>/

# ---- clean-machine host deps (ohos-ci-env.sh) -------------------------------
: "${NDK_URL:=https://repo.huaweicloud.com/openharmony/os/6.0.0.1-Release/ohos-sdk-windows_linux-public.tar.gz}"
: "${OPENSSL_VERSION:=3.3.1}"
: "${ICU_VERSION:=75.1}"
